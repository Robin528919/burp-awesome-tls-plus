{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "revision": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "timestamp": {
      "type": "string",
      "maxLength": 32
    },
    "chunkReference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "scopeDigest",
        "path",
        "totalUtf8Bytes",
        "sha256",
        "cursor"
      ],
      "properties": {
        "kind": {
          "const": "chunk_reference"
        },
        "scopeDigest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "path": {
          "type": "string",
          "maxLength": 4096
        },
        "totalUtf8Bytes": {
          "type": "integer",
          "minimum": 0
        },
        "sha256": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "cursor": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        }
      }
    },
    "stringValue": {
      "oneOf": [
        {
          "type": "string",
          "maxLength": 262144
        },
        {
          "$ref": "#/$defs/chunkReference"
        }
      ]
    },
    "scalarValue": {
      "oneOf": [
        {
          "type": "string",
          "maxLength": 262144
        },
        {
          "$ref": "#/$defs/chunkReference"
        },
        {
          "type": "integer"
        },
        {
          "type": "boolean"
        },
        {
          "type": "null"
        }
      ]
    },
    "message": {
      "type": "string",
      "maxLength": 4096
    },
    "path": {
      "type": "string",
      "maxLength": 4096
    },
    "errorDetail": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reason"
      ],
      "properties": {
        "path": {
          "$ref": "#/$defs/path"
        },
        "reason": {
          "type": "string",
          "maxLength": 4096
        },
        "expected": {
          "$ref": "#/$defs/scalarValue"
        },
        "actual": {
          "$ref": "#/$defs/scalarValue"
        }
      }
    },
    "businessError": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "schemaVersion",
        "status",
        "code",
        "message",
        "details",
        "retryable"
      ],
      "properties": {
        "kind": {
          "const": "error"
        },
        "schemaVersion": {
          "const": "awesome_tls.settings.v1"
        },
        "status": {
          "const": "ERROR"
        },
        "code": {
          "enum": [
            "UNSUPPORTED_SCHEMA",
            "VALIDATION_FAILED",
            "REVISION_CONFLICT",
            "DIRTY_UI",
            "PROPOSAL_PENDING",
            "EXPIRED",
            "REQUEST_ID_CONFLICT",
            "IDEMPOTENCY_CAPACITY",
            "HIDDEN_RULE_CONFLICT",
            "AMBIGUOUS_FINGERPRINT_HEX",
            "CURSOR_INVALID",
            "CURSOR_STALE",
            "RULE_FILE_INVALID",
            "EXTERNAL_DIVERGENCE",
            "MERGE_CONFLICT",
            "AUDIT_UNAVAILABLE",
            "CONTROL_DISABLED",
            "PERSISTENCE_FAILED",
            "RECOVERY_REQUIRED"
          ]
        },
        "message": {
          "$ref": "#/$defs/message"
        },
        "details": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/errorDetail"
          }
        },
        "retryable": {
          "type": "boolean"
        },
        "currentRevision": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      }
    },
    "fieldChange": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "operation",
            "path",
            "after"
          ],
          "properties": {
            "operation": {
              "const": "add"
            },
            "path": {
              "$ref": "#/$defs/path"
            },
            "after": {
              "$ref": "#/$defs/scalarValue"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "operation",
            "path",
            "before",
            "after"
          ],
          "properties": {
            "operation": {
              "const": "replace"
            },
            "path": {
              "$ref": "#/$defs/path"
            },
            "before": {
              "$ref": "#/$defs/scalarValue"
            },
            "after": {
              "$ref": "#/$defs/scalarValue"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "operation",
            "path",
            "before"
          ],
          "properties": {
            "operation": {
              "const": "remove"
            },
            "path": {
              "$ref": "#/$defs/path"
            },
            "before": {
              "$ref": "#/$defs/scalarValue"
            }
          }
        }
      ]
    },
    "riskFlag": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "severity",
        "paths",
        "message"
      ],
      "properties": {
        "code": {
          "type": "string",
          "pattern": "^[A-Z0-9_]{1,128}$"
        },
        "severity": {
          "enum": [
            "LOW",
            "MEDIUM",
            "HIGH"
          ]
        },
        "paths": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/path"
          }
        },
        "message": {
          "$ref": "#/$defs/message"
        }
      }
    },
    "runtimeImpact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "effect",
        "requiresUserAction",
        "message"
      ],
      "properties": {
        "path": {
          "$ref": "#/$defs/path"
        },
        "effect": {
          "enum": [
            "NEXT_REQUEST",
            "NEXT_START",
            "RELOAD_REQUIRED",
            "RESTART_REQUIRED"
          ]
        },
        "requiresUserAction": {
          "type": "boolean"
        },
        "message": {
          "$ref": "#/$defs/message"
        }
      }
    },
    "businessSettings": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "spoofProxyAddress",
        "interceptProxyAddress",
        "burpProxyAddress",
        "fingerprint",
        "hexClientHello",
        "useInterceptedFingerprint",
        "httpTimeout",
        "externalProxyUrl"
      ],
      "properties": {
        "spoofProxyAddress": {
          "type": "string",
          "maxLength": 4096
        },
        "interceptProxyAddress": {
          "type": "string",
          "maxLength": 4096
        },
        "burpProxyAddress": {
          "type": "string",
          "maxLength": 4096
        },
        "fingerprint": {
          "type": "string",
          "maxLength": 256
        },
        "hexClientHello": {
          "$ref": "#/$defs/stringValue"
        },
        "useInterceptedFingerprint": {
          "type": "boolean"
        },
        "httpTimeout": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3600
        },
        "externalProxyUrl": {
          "$ref": "#/$defs/stringValue"
        }
      }
    },
    "domainRule": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "hostPattern",
        "enabled",
        "fingerprint",
        "hexClientHello",
        "externalProxyUrl",
        "httpTimeout",
        "note"
      ],
      "properties": {
        "hostPattern": {
          "type": "string",
          "maxLength": 255
        },
        "enabled": {
          "type": "boolean"
        },
        "fingerprint": {
          "type": "string",
          "maxLength": 256
        },
        "hexClientHello": {
          "$ref": "#/$defs/stringValue"
        },
        "externalProxyUrl": {
          "$ref": "#/$defs/stringValue"
        },
        "httpTimeout": {
          "oneOf": [
            {
              "type": "integer",
              "minimum": 1,
              "maximum": 3600
            },
            {
              "type": "null"
            }
          ]
        },
        "note": {
          "type": "string",
          "maxLength": 500
        }
      }
    },
    "runtimeState": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "configured",
        "active",
        "effect"
      ],
      "properties": {
        "path": {
          "$ref": "#/$defs/path"
        },
        "configured": {
          "$ref": "#/$defs/scalarValue"
        },
        "active": {
          "$ref": "#/$defs/scalarValue"
        },
        "effect": {
          "enum": [
            "ACTIVE_NOW",
            "NEXT_REQUEST",
            "NEXT_START",
            "RELOAD_REQUIRED",
            "RESTART_REQUIRED"
          ]
        }
      }
    },
    "effectiveConfig": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "host",
        "matchedRuleHostPattern",
        "transport",
        "sources",
        "tlsResolution"
      ],
      "properties": {
        "host": {
          "type": "string",
          "maxLength": 253
        },
        "matchedRuleHostPattern": {
          "oneOf": [
            {
              "type": "string",
              "maxLength": 255
            },
            {
              "type": "null"
            }
          ]
        },
        "transport": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "fingerprint",
            "hexClientHello",
            "externalProxyUrl",
            "httpTimeout",
            "useInterceptedFingerprint",
            "interceptProxyAddress",
            "burpProxyAddress"
          ],
          "properties": {
            "fingerprint": {
              "type": "string",
              "maxLength": 256
            },
            "hexClientHello": {
              "$ref": "#/$defs/stringValue"
            },
            "externalProxyUrl": {
              "$ref": "#/$defs/stringValue"
            },
            "httpTimeout": {
              "type": "integer",
              "minimum": 1,
              "maximum": 3600
            },
            "useInterceptedFingerprint": {
              "type": "boolean"
            },
            "interceptProxyAddress": {
              "type": "string",
              "maxLength": 4096
            },
            "burpProxyAddress": {
              "type": "string",
              "maxLength": 4096
            }
          }
        },
        "sources": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "fingerprint",
            "hexClientHello",
            "externalProxyUrl",
            "httpTimeout",
            "useInterceptedFingerprint",
            "interceptProxyAddress",
            "burpProxyAddress"
          ],
          "properties": {
            "fingerprint": {
              "type": "string",
              "maxLength": 4096
            },
            "hexClientHello": {
              "type": "string",
              "maxLength": 4096
            },
            "externalProxyUrl": {
              "type": "string",
              "maxLength": 4096
            },
            "httpTimeout": {
              "type": "string",
              "maxLength": 4096
            },
            "useInterceptedFingerprint": {
              "const": "GLOBAL_DEFAULT"
            },
            "interceptProxyAddress": {
              "const": "GLOBAL_DEFAULT"
            },
            "burpProxyAddress": {
              "const": "GLOBAL_DEFAULT"
            }
          }
        },
        "tlsResolution": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "staticMode",
            "runtimeMode",
            "selectedPath",
            "suppressedPaths"
          ],
          "properties": {
            "staticMode": {
              "enum": [
                "HEX_CLIENT_HELLO",
                "FINGERPRINT",
                "LIBRARY_DEFAULT"
              ]
            },
            "runtimeMode": {
              "enum": [
                "STATIC",
                "INTERCEPTED_IF_AVAILABLE_ELSE_STATIC"
              ]
            },
            "selectedPath": {
              "oneOf": [
                {
                  "$ref": "#/$defs/path"
                },
                {
                  "type": "null"
                }
              ]
            },
            "suppressedPaths": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/path"
              }
            }
          }
        }
      }
    },
    "proposalState": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status"
          ],
          "properties": {
            "status": {
              "const": "NONE"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "proposalId",
            "proposalDigest",
            "baseRevision",
            "candidateRevision",
            "createdAt",
            "expiresAt",
            "reviewGeneration",
            "summary",
            "diff",
            "riskFlags",
            "runtimeImpact"
          ],
          "properties": {
            "status": {
              "const": "PENDING"
            },
            "proposalId": {
              "type": "string",
              "maxLength": 4096
            },
            "proposalDigest": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            },
            "baseRevision": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            },
            "candidateRevision": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            },
            "createdAt": {
              "type": "string",
              "maxLength": 32
            },
            "expiresAt": {
              "type": "string",
              "maxLength": 32
            },
            "reviewGeneration": {
              "type": "integer",
              "minimum": 1
            },
            "summary": {
              "type": "string",
              "maxLength": 500
            },
            "diff": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/fieldChange"
              }
            },
            "riskFlags": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/riskFlag"
              }
            },
            "runtimeImpact": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/runtimeImpact"
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "proposalId",
            "reason",
            "rejectedAt"
          ],
          "properties": {
            "status": {
              "const": "REJECTED"
            },
            "proposalId": {
              "type": "string",
              "maxLength": 4096
            },
            "reason": {
              "$ref": "#/$defs/message"
            },
            "rejectedAt": {
              "type": "string",
              "maxLength": 32
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "proposalId",
            "reason",
            "expiredAt"
          ],
          "properties": {
            "status": {
              "const": "EXPIRED"
            },
            "proposalId": {
              "type": "string",
              "maxLength": 4096
            },
            "reason": {
              "const": "TTL_EXPIRED"
            },
            "expiredAt": {
              "type": "string",
              "maxLength": 32
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "proposalId",
            "code",
            "message",
            "details",
            "detectedAt",
            "currentRevision"
          ],
          "properties": {
            "status": {
              "const": "CONFLICTED"
            },
            "proposalId": {
              "type": "string",
              "maxLength": 4096
            },
            "code": {
              "enum": [
                "REVISION_CONFLICT",
                "EXTERNAL_DIVERGENCE",
                "MERGE_CONFLICT",
                "DIRTY_UI"
              ]
            },
            "message": {
              "$ref": "#/$defs/message"
            },
            "details": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/errorDetail"
              }
            },
            "detectedAt": {
              "type": "string",
              "maxLength": 32
            },
            "currentRevision": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            }
          }
        }
      ]
    },
    "sectionContinuation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "section",
        "cursor"
      ],
      "properties": {
        "section": {
          "enum": [
            "rules",
            "fingerprints",
            "runtime",
            "proposal",
            "effectiveConfig"
          ]
        },
        "cursor": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        }
      }
    }
  },
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "schemaVersion",
        "revision",
        "dirty",
        "dirtyReasons",
        "hiddenInvalidRuleCount",
        "sections"
      ],
      "properties": {
        "kind": {
          "const": "inspect_page"
        },
        "schemaVersion": {
          "const": "awesome_tls.settings.v1"
        },
        "revision": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "dirty": {
          "type": "boolean"
        },
        "dirtyReasons": {
          "type": "array",
          "items": {
            "enum": [
              "ACTIVE_CELL_EDITOR",
              "PENDING_AUTOSAVE",
              "UNSAVED_UI_DRAFT"
            ]
          }
        },
        "hiddenInvalidRuleCount": {
          "type": "integer",
          "minimum": 0
        },
        "sections": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "settings": {
              "$ref": "#/$defs/businessSettings"
            },
            "rules": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/domainRule"
              }
            },
            "fingerprints": {
              "type": "array",
              "items": {
                "type": "string",
                "maxLength": 256
              }
            },
            "runtime": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/runtimeState"
              }
            },
            "proposal": {
              "$ref": "#/$defs/proposalState"
            },
            "effectiveConfigs": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/effectiveConfig"
              }
            }
          }
        },
        "continuations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/sectionContinuation"
          }
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "schemaVersion",
        "revision",
        "scopeDigest",
        "path",
        "offsetUtf8Bytes",
        "totalUtf8Bytes",
        "sha256",
        "data"
      ],
      "properties": {
        "kind": {
          "const": "inspect_chunk"
        },
        "schemaVersion": {
          "const": "awesome_tls.settings.v1"
        },
        "revision": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "scopeDigest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "path": {
          "$ref": "#/$defs/path"
        },
        "offsetUtf8Bytes": {
          "type": "integer",
          "minimum": 0
        },
        "totalUtf8Bytes": {
          "type": "integer",
          "minimum": 0
        },
        "sha256": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "data": {
          "type": "string",
          "maxLength": 262144
        },
        "nextCursor": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        }
      }
    },
    {
      "$ref": "#/$defs/businessError"
    }
  ]
}
